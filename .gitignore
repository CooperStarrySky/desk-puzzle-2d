# Generated texture binaries — kept out of git per workspace rule (big binaries never enter git).
# manifest.json and CHATGPT_PROMPTS.md stay tracked.
assets/textures/*.png
assets/textures/*.jpg
assets/textures/originals/
assets/textures/overlays/

# Generated from the authored puzzle for file:// previews; never publish a
# duplicate of the embedded image payload.
puzzles/.local-puzzle-fallback.js

# Python bytecode from tools/
__pycache__/

# Category submissions and assembled drafts (tools/import_submission.py,
# tools/assemble_puzzle.py). They hold puzzle answers and private contact
# emails, and this repo is public, so they never go into git.
submissions/
